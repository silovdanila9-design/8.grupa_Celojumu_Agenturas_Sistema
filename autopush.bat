@echo off
:: Переходим в кодировку UTF-8, чтобы в консоли нормально отображался русский текст
chcp 65001 > nul

:loop
echo [%time%] Проверяем изменения в проекте...

:: 1. Добавляем все новые и измененные файлы в индекс Git
git add .

:: 2. Делаем коммит. Если изменений нет, Git просто пропустит этот шаг
git commit -m "Авто-сохранение: %date% %time%"

:: 3. Отправляем изменения в репозиторий на GitHub
git push origin master

echo [%time%] Все изменения отправлены в репозиторий! Ожидание 5 минут...
echo --------------------------------------------------

:: Пауза в секундах (300 секунд = 5 минут). Можно изменить на 60 (1 минута)
timeout /t 300

goto loop
